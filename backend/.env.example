# Porta exposta pelo Render (não altere)
PORT=3000

# URL de conexão completa (MySQL em AlwaysData, PlanetScale, etc.)
# Formato: mysql://usuario:senha@host:3306/nome_do_banco
DATABASE_URL="mysql://usuario:senha@host:3306/moneymap"

# URLs autorizadas a chamar a API (separe por vírgula)
CORS_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com

# Redirecionamento padrão quando acessar "/"
FRONTEND_URL=https://app.seudominio.com

# Servir build estático do frontend (opcional)
# Exemplos: /opt/render/project/src/frontend/dist
STATIC_DIR=

# JWT e segurança
JWT_SECRET=troque-por-uma-chave-segura

# Logs verbosos (use false em produção)
LOG_BODY=false

# E-mail / notificações (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Preferências padrão de alertas
NOTIFY_BUDGET_THRESHOLD=0.8
NOTIFY_DEBT_DAYS=3
